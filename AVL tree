class Enrollment:
    def __init__(self, enrollment_id, student_name, course):
        self.enrollment_id = enrollment_id
        self.student_name = student_name
        self.course = course
    def __str__(self):
        return f"ID: {self.enrollment_id}, Name: {self.student_name}, Course: {self.course}"
class AVLNode:
    def __init__(self, enrollment):
        self.enrollment = enrollment
        self.left = None
        self.right = None
        self.height = 1
class AVLTree:
    def __init__(self):
        self.root = None
        self.count = 0
    def get_height(self, node):
        if node is None:
            return 0
        return node.height
    def get_balance(self, node):
        if node is None:
            return 0
        return self.get_height(node.left) - self.get_height(node.right)
    def update_height(self, node):
        node.height = 1 + max(
            self.get_height(node.left),
            self.get_height(node.right)
        )
    def right_rotate(self, y):
        x = y.left
        temp = x.right
        x.right = y
        y.left = temp
        self.update_height(y)
        self.update_height(x)
        return x
    def left_rotate(self, x):
        y = x.right
        temp = y.left
        y.left = x
        x.right = temp
        self.update_height(x)
        self.update_height(y)
        return y
    def insert(self, enrollment):
        self.root, inserted = self._insert(self.root, enrollment)
        if inserted:
            self.count += 1
            print("Enrollment inserted successfully.")
        else:
            print("Enrollment ID already exists.")
    def _insert(self, node, enrollment):
        if node is None:
            return AVLNode(enrollment), True
        if enrollment.enrollment_id < node.enrollment.enrollment_id:
            node.left, inserted = self._insert(node.left, enrollment)
        elif enrollment.enrollment_id > node.enrollment.enrollment_id:
            node.right, inserted = self._insert(node.right, enrollment)
        else:
            return node, False
        self.update_height(node)
        balance = self.get_balance(node)
        if balance > 1 and enrollment.enrollment_id < node.left.enrollment.enrollment_id:
            return self.right_rotate(node), inserted
        if balance < -1 and enrollment.enrollment_id > node.right.enrollment.enrollment_id:
            return self.left_rotate(node), inserted
        if balance > 1 and enrollment.enrollment_id > node.left.enrollment.enrollment_id:
            node.left = self.left_rotate(node.left)
            return self.right_rotate(node), inserted
        if balance < -1 and enrollment.enrollment_id < node.right.enrollment.enrollment_id:
            node.right = self.right_rotate(node.right)
            return self.left_rotate(node), inserted
        return node, inserted
    def search(self, enrollment_id):
        current = self.root
        while current is not None:
            if enrollment_id == current.enrollment.enrollment_id:
                return current.enrollment
            elif enrollment_id < current.enrollment.enrollment_id:
                current = current.left
            else:
                current = current.right
        return None
    def delete(self, enrollment_id):
        self.root, deleted = self._delete(self.root, enrollment_id)
        if deleted:
            self.count -= 1
            print("Enrollment deleted successfully.")
        else:
            print("Enrollment ID not found.")
    def _delete(self, node, enrollment_id):
        if node is None:
            return None, False
        if enrollment_id < node.enrollment.enrollment_id:
            node.left, deleted = self._delete(node.left, enrollment_id)
        elif enrollment_id > node.enrollment.enrollment_id:
            node.right, deleted = self._delete(node.right, enrollment_id)
        else:
            if node.left is None:
                return node.right, True
            elif node.right is None:
                return node.left, True
            successor = self.get_min_node(node.right)
            node.enrollment = successor.enrollment
            node.right, _ = self._delete(
                node.right,
                successor.enrollment.enrollment_id
            )
            deleted = True
        if node is None:
            return node, deleted
        self.update_height(node)
        balance = self.get_balance(node)
        if balance > 1 and self.get_balance(node.left) >= 0:
            return self.right_rotate(node), deleted
        if balance > 1 and self.get_balance(node.left) < 0:
            node.left = self.left_rotate(node.left)
            return self.right_rotate(node), deleted
        if balance < -1 and self.get_balance(node.right) <= 0:
            return self.left_rotate(node), deleted
        if balance < -1 and self.get_balance(node.right) > 0:
            node.right = self.right_rotate(node.right)
            return self.left_rotate(node), deleted
        return node, deleted
    def get_min_node(self, node):
        current = node
        while current.left is not None:
            current = current.left
        return current
    def inorder(self):
        records = []
        self._inorder(self.root, records)
        return records
    def _inorder(self, node, records):
        if node is not None:
            self._inorder(node.left, records)
            records.append(node.enrollment)
            self._inorder(node.right, records)
    def display_all(self):
        records = self.inorder()
        if not records:
            print("No enrollment records found.")
            return
        print("\nEnrollment Records (Sorted by Enrollment ID)")
        print("-" * 55)
        for record in records:
            print(record)
    def get_count(self):
        return self.count
def main():
    tree = AVLTree()
    while True:
        print("\n===== STUDENT ENROLLMENT AVL TREE =====")
        print("1. Insert Enrollment Record")
        print("2. Delete Enrollment Record")
        print("3. Search Enrollment")
        print("4. Display All Enrollments")
        print("5. Count Total Enrollments")
        print("6. Exit")
        choice = input("Enter your choice: ")
        if choice == "1":
            try:
                enrollment_id = int(input("Enter Enrollment ID: "))
                student_name = input("Enter Student Name: ")
                course = input("Enter Course: ")
                enrollment = Enrollment(
                    enrollment_id,
                    student_name,
                    course
                )
                tree.insert(enrollment)
            except ValueError:
                print("Enrollment ID must be an integer.")
        elif choice == "2":
            try:
                enrollment_id = int(input("Enter Enrollment ID to delete: "))
                tree.delete(enrollment_id)
            except ValueError:
                print("Enrollment ID must be an integer.")
        elif choice == "3":
            try:
                enrollment_id = int(input("Enter Enrollment ID to search: "))
                result = tree.search(enrollment_id)
                if result:
                    print("\nEnrollment Found:")
                    print(result)
                else:
                    print("Enrollment ID not found.")
            except ValueError:
                print("Enrollment ID must be an integer.")
        elif choice == "4":
            tree.display_all()
        elif choice == "5":
            print("Total Enrollments:", tree.get_count())
        elif choice == "6":
            print("Program terminated.")
            break
        else:
            print("Invalid choice. Please try again.")
if __name__ == "__main__":
    main()
