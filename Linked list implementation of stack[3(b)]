class Node:
    def __init__(self, data):
        self.data = data
        self.next = None


class Stack:
    def __init__(self):
        self.top = None

    def is_empty(self):
        return self.top is None

    def push(self, data):
        new_node = Node(data)
        new_node.next = self.top
        self.top = new_node

    def pop(self):
        if self.is_empty():
            return None

        data = self.top.data
        self.top = self.top.next
        return data

    def peek(self):
        if self.is_empty():
            return None

        return self.top.data

    def display(self):
        if self.is_empty():
            print("Stack is empty")
            return

        temp = self.top

        while temp:
            print("Book Title:", temp.data)
            temp = temp.next


# Main program
stack = Stack()

n = int(input("Enter the number of books: "))

for i in range(n):
    b = input("Enter book title to push: ")
    stack.push(b)

m = int(input("Enter no. of books to pop: "))

for i in range(m):
    print("Pop:", stack.pop())

print("Peek:", stack.peek())
print("Is empty:", stack.is_empty())

print("\nRemaining books in stack:")
stack.display()
